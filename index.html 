<script>
'use strict';

/* ═════════ Firebase ═════════ */
let fb=null, fbRef=null, fbRoomId=null, fbMyRole=null, fbUnsubscribe=null;
const fbConfigSaved=localStorage.getItem('bs_fb_cfg');
if(fbConfigSaved){
  try{initFirebase(JSON.parse(fbConfigSaved))}catch(e){console.warn('Firebase init failed',e)}
}
function initFirebase(cfg){
  try{
    if(fb){fb.app.delete().catch(()=>{})}
    const app=firebase.initializeApp(cfg,'app_'+Date.now());
    fb={app,db:firebase.database(app)};
    $('#fbStatus').className='ok';$('#fbStatus').textContent='✅ Firebase подключён';
    $('#fbCfg').value=JSON.stringify(cfg,null,2);
    $('#netMain').classList.remove('hidden');
    return true;
  }catch(e){
    $('#fbStatus').className='err';$('#fbStatus').textContent='❌ Ошибка: '+e.message;
    return false;
  }
}
$('#btnFbSave').onclick=()=>{
  const v=$('#fbCfg').value.trim();
  let cfg;
  try{
    // поддержим формат "const firebaseConfig = { ... }"
    const m=v.match(/\{[\s\S]*\}/);
    cfg=m?JSON.parse(m[0].replace(/(\w+):/g,'"$1":')):JSON.parse(v);
  }catch(e){toast('Неверный формат конфига');return}
  if(!cfg.databaseURL){toast('Нет databaseURL в конфиге');return}
  if(initFirebase(cfg))localStorage.setItem('bs_fb_cfg',JSON.stringify(cfg));
};

/* ═════════ утилиты ═════════ */
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const store={get(k,d){try{const v=localStorage.getItem(k);return v==null?d:JSON.parse(v)}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
const LETTERS=['А','Б','В','Г','Д','Е','Ж','З','И','К'];
const SIZES=[4,3,3,2,2,2,1,1,1,1];
const fmtCell=c=>LETTERS[c%10]+(((c/10)|0)+1);
const fmtLen=n=>['','однопалубный','двухпалубный','трёхпалубный','четырёхпалубный'][n];
let settings=store.get('bs_set',{vibro:true,fx:true,halo:true});
let toastT;function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('on'),2400)}
function vib(p){if(settings.vibro&&navigator.vibrate)try{navigator.vibrate(p)}catch(e){}}
function nav(id){$$('.scr').forEach(s=>s.classList.toggle('on',s.id==='scr-'+id));window.scrollTo(0,0)}
function handoff(title,txt,cb){$('#hoTitle').textContent=title;$('#hoTxt').textContent=txt;$('#handoff').classList.remove('hidden');$('#hoBtn').onclick=()=>{$('#handoff').classList.add('hidden');cb&&cb()}}
const randCode=()=>{const c='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let s='';for(let i=0;i<6;i++)s+=c[(Math.random()*c.length)|0];return s};

/* ═════════ звук ═════════ */
let AC=null;
function tone(f0,f1,dur,type,vol){const t=AC.currentTime,o=AC.createOscillator(),g=AC.createGain();o.type=type;o.frequency.setValueAtTime(f0,t);o.frequency.exponentialRampToValueAtTime(Math.max(f1,20),t+dur);g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.001,t+dur);o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+dur+.02)}
function noise(dur,freq,vol){const t=AC.currentTime,n=AC.sampleRate*dur|0,b=AC.createBuffer(1,n,AC.sampleRate),d=b.getChannelData(0);for(let i=0;i<n;i++)d[i]=Math.random()*2-1;const s=AC.createBufferSource();s.buffer=b;const f=AC.createBiquadFilter();f.type='lowpass';f.frequency.value=freq;const g=AC.createGain();g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.001,t+dur);s.connect(f);f.connect(g);g.connect(AC.destination);s.start(t)}
function sfx(name){if(!settings.fx)return;try{AC=AC||new (window.AudioContext||window.webkitAudioContext)();if(AC.state==='suspended')AC.resume();
  if(name==='shoot')tone(620,150,.13,'square',.12);
  else if(name==='splash')noise(.35,800,.22);
  else if(name==='boom'){noise(.4,260,.4);tone(130,38,.35,'sine',.35)}
  else if(name==='sink'){noise(.5,200,.45);tone(160,30,.5,'sawtooth',.25)}
  else if(name==='place')tone(760,520,.07,'triangle',.15);
  else if(name==='ui')tone(500,480,.045,'triangle',.08);
  else if(name==='win')[523,659,784,1046].forEach((f,i)=>setTimeout(()=>tone(f,f,.16,'triangle',.2),i*130));
  else if(name==='lose')[392,311,233].forEach((f,i)=>setTimeout(()=>tone(f,f*.9,.24,'sine',.2),i*180));
}catch(e){}}

function fxBoom(el){if(!settings.fx)return;const s=document.createElement('i');s.className='boomfx';el.appendChild(s);setTimeout(()=>s.remove(),600)}
function fxSplash(el){if(!settings.fx)return;const r=document.createElement('i');r.className='ringfx';el.appendChild(r);setTimeout(()=>r.remove(),750);
  const w=el.offsetWidth||30;for(let k=0;k<5;k++){const d=document.createElement('i');d.className='dropfx';const a=Math.random()*6.283,rr=w*(.7+Math.random()*.9);d.style.setProperty('--dx',Math.cos(a)*rr+'px');d.style.setProperty('--dy',(Math.sin(a)*rr-w*1.2)+'px');el.appendChild(d);setTimeout(()=>d.remove(),650)}}

/* ═════════ флот: логика ═════════ */
const X=c=>c%10, Y=c=>(c/10)|0;
function adj8(c){const r=[];for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){if(!dx&&!dy)continue;const x=X(c)+dx,y=Y(c)+dy;if(x>=0&&x<10&&y>=0&&y<10)r.push(y*10+x)}return r}
function cellsAt(x,y,len,horiz){const arr=[];for(let k=0;k<len;k++)arr.push(horiz?y*10+x+k:(y+k)*10+x);return arr}
function cellsFromStart(start,len,horiz){return cellsAt(X(start),Y(start),len,horiz)}
function shipOrient(cells){return cells.length>1 && cells[1]===cells[0]+1}
function shipBounds(cells){const xs=cells.map(X),ys=cells.map(Y);return{minX:Math.min(...xs),maxX:Math.max(...xs),minY:Math.min(...ys),maxY:Math.max(...ys)}}
/* поворот корабля вокруг его центра */
function rotateAroundCenter(cells){
  if(cells.length===1)return cells.slice();
  const horiz=shipOrient(cells);
  const b=shipBounds(cells);
  const cx=(b.minX+b.maxX)/2, cy=(b.minY+b.maxY)/2;
  const newCells=[];
  for(const c of cells){
    const dx=X(c)-cx, dy=Y(c)-cy;
    // поворот на 90°: (dx,dy) -> (-dy,dx)
    const nx=Math.round(cx - dy), ny=Math.round(cy + dx);
    if(nx<0||nx>9||ny<0||ny>9)return null;
    newCells.push(ny*10+nx);
  }
  return newCells;
}
function canPlaceCells(ships,newCells,ignoreIdx){
  for(let i=0;i<ships.length;i++){
    if(i===ignoreIdx)continue;
    for(const c of newCells){
      if(ships[i].includes(c))return false;
      if(adj8(c).some(n=>ships[i].includes(n)))return false;
    }
  }
  // проверяем границы
  for(const c of newCells)if(c<0||c>99)return false;
  return true;
}
function randomLayout(){
  for(let rep=0;rep<100;rep++){
    const ships=[];let ok=true;
    for(const len of SIZES){
      let done=false;
      for(let t=0;t<400&&!done;t++){
        const horiz=Math.random()<.5;
        const x=(Math.random()*(horiz?11-len:10))|0;
        const y=(Math.random()*(horiz?10:11-len))|0;
        const cells=cellsAt(x,y,len,horiz);
        if(canPlaceCells(ships,cells,-1)){ships.push(cells);done=true}
      }
      if(!done){ok=false;break}
    }
    if(ok)return ships;
  }
  return null;
}
function checkShot(ships,hits,cell){
  const si=ships.findIndex(s=>s.includes(cell));
  if(si<0)return{res:'m'};
  const sh=ships[si];
  if(!sh.every(c=>c===cell||hits.has(c)))return{res:'h',si,sh};
  const around=[];
  sh.forEach(c=>adj8(c).forEach(n=>{if(!sh.includes(n)&&!hits.has(n)&&!around.includes(n))around.push(n)}));
  return{res:'s',si,sh,around};
}

/* ═════════ ИИ ═════════ */
function makeAI(){
  let trail=[];
  return{
    choose(taken){
      let cands=[];
      if(trail.length===1){
        cands=adj8(trail[0]).filter(i=>!taken.has(i)&&(X(i)===X(trail[0])||Y(i)===Y(trail[0])));
      }else if(trail.length>1){
        const s=[...trail].sort((a,b)=>a-b),hz=s.every(c=>Y(c)===Y(s[0]));
        if(hz){const a=s[0],b=s[s.length-1];if(X(a)>0)cands.push(a-1);if(X(b)<9)cands.push(b+1)}
        else{if(s[0]>=10)cands.push(s[0]-10);if(s[s.length-1]<90)cands.push(s[s.length-1]+10)}
        cands=cands.filter(i=>!taken.has(i));
      }
      if(!cands.length){
        const free=[];for(let i=0;i<100;i++)if(!taken.has(i))free.push(i);
        const par=free.filter(i=>(X(i)+Y(i))%2===0);cands=par.length?par:free;
      }
      return cands[(Math.random()*cands.length)|0];
    },
    hit(c){trail.push(c)},
    sunk(){trail=[]}
  };
}

/* ═════════ построитель поля ═════════ */
function buildBoard(el){
  el.innerHTML='';const cells=[];
  const corner=document.createElement('div');corner.className='corner';el.appendChild(corner);
  LETTERS.forEach(L=>{const d=document.createElement('div');d.className='lbl';d.textContent=L;el.appendChild(d)});
  for(let r=0;r<10;r++){
    const l=document.createElement('div');l.className='lbl';l.textContent=r+1;el.appendChild(l);
    for(let c=0;c<10;c++){
      const d=document.createElement('div');d.className='c';d.dataset.idx=r*10+c;el.appendChild(d);cells.push(d);
    }
  }
  return cells;
}
function fleetChips(el,list){
  el.innerHTML='';list.forEach(f=>{
    const ch=document.createElement('span');ch.className='fchip'+(f.dead?' dead':'');
    for(let i=0;i<f.len;i++)ch.appendChild(document.createElement('i'));el.appendChild(ch);
  });
}

/* ═════════ РАССТАНОВКА (УЛУЧШЕННАЯ) ═════════ */
const P={
  mode:null,phase:0,ships:[],cells:[],
  holding:null, /* {len,orient} или null */
  selectedIdx:-1,
  orient:true, /* true = горизонт */
  hover:-1,
  
  start(mode,phase){
    this.mode=mode;this.phase=phase||0;
    this.ships=[];this.orient=true;this.holding=null;this.selectedIdx=-1;this.hover=-1;
    this.cells=buildBoard($('#bP'));
    const titles={ai:'Расставьте ваш флот',hs:`Игрок ${(this.phase+1)} — расстановка кораблей`,net:'Расставьте ваш флот'};
    $('#placeTitle').textContent=titles[mode]||'Расстановка';
    $('#chkHalo').checked=settings.halo;
    this.draw();this.drawDock();nav('place');
  },
  
  blocked(){
    const b=new Set();
    this.ships.forEach(sh=>sh.forEach(c=>{b.add(c);adj8(c).forEach(n=>b.add(n))}));
    return b;
  },
  
  draw(){
    this.cells.forEach(el=>el.className='c');
    const bl=settings.halo?this.blocked():new Set();
    if(settings.halo)bl.forEach(c=>{if(!this.ships.some(s=>s.includes(c)))this.cells[c].classList.add('halo')});
    this.ships.forEach((sh,i)=>sh.forEach(c=>{
      this.cells[c].classList.add('ship');
      if(i===this.selectedIdx)this.cells[c].classList.add('sel');
    }));
    if(this.holding && this.hover>=0){
      const cells=cellsFromStart(this.hover,this.holding.len,this.orient);
      const ok=canPlaceCells(this.ships,cells,-1);
      cells.forEach(c=>{if(c>=0&&c<100)this.cells[c].classList.add(ok?'prevok':'prevbad')});
    }
    $('#btnPlaceDone').disabled=this.ships.length<10;
    $('#btnRemove').disabled=this.selectedIdx<0;
    const h=$('#placeHint');
    if(this.holding){h.textContent=`В руке: ${fmtLen(this.holding.len)} (${this.orient?'▬ гориз':'▮ верт'}) · тап по полю — поставить`}
    else if(this.selectedIdx>=0){h.textContent=`Выбран корабль · тап по нему — повернуть · ✕ — убрать`}
    else if(this.ships.length<10){h.textContent=`Осталось: ${10-this.ships.length} кораблей · выбери в доке ↓`}
    else{h.textContent='🎉 Флот готов! Жми «В бой!»'}
  },
  
  drawDock(){
    const d=$('#dock');d.innerHTML='';
    const used={};this.ships.forEach(s=>used[s.length]=(used[s.length]||0)+1);
    [4,3,2,1].forEach(len=>{
      const need=SIZES.filter(s=>s===len).length,have=used[len]||0,left=need-have;
      const ch=document.createElement('div');
      ch.className='dchip'+(left>0?' avail':' empty')+(this.holding&&this.holding.len===len?' sel':'');
      for(let i=0;i<len;i++)ch.appendChild(document.createElement('i'));
      const count=document.createElement('span');count.className='count';count.textContent='×'+left;ch.appendChild(count);
      ch.onclick=()=>{
        if(left<=0)return;
        if(this.holding && this.holding.len===len){this.holding=null}
        else{this.holding={len,orient:this.orient};this.selectedIdx=-1}
        sfx('ui');this.drawDock();this.draw();
      };
      d.appendChild(ch);
    });
  },
  
  setHover(i){if(this.hover===i)return;this.hover=i;this.draw()},
  
  tap(i){
    if(this.holding){
      const cells=cellsFromStart(i,this.holding.len,this.orient);
      if(canPlaceCells(this.ships,cells,-1)){
        this.ships.push(cells);
        vib(20);sfx('place');
        const left=SIZES.filter(s=>s===this.holding.len).length-this.ships.filter(s=>s.length===this.holding.len).length;
        if(left<=0)this.holding=null;
        this.selectedIdx=-1;
        this.draw();this.drawDock();
      }else{
        vib(50);
        cells.forEach(c=>{if(c>=0&&c<100){this.cells[c].classList.add('badflash');setTimeout(()=>this.cells[c]&&this.cells[c].classList.remove('badflash'),350)}});
        toast('⛔ Нельзя: корабли должны быть на расстоянии 1 клетки');
      }
      return;
    }
    
    const idx=this.ships.findIndex(s=>s.includes(i));
    if(idx>=0){
      if(this.selectedIdx===idx){
        // повторный тап — поворот вокруг центра
        const rotated=rotateAroundCenter(this.ships[idx]);
        if(rotated && canPlaceCells(this.ships,rotated,idx)){
          this.ships[idx]=rotated;
          vib(20);sfx('place');this.draw();
        }else{
          vib(50);toast('⟳ Здесь повернуть нельзя');
        }
      }else{
        this.selectedIdx=idx;vib(15);sfx('ui');this.draw();
      }
      return;
    }
    
    this.selectedIdx=-1;
    this.draw();
  },
  
  rotate(){
    if(this.holding){
      this.orient=!this.orient;
      this.holding.orient=this.orient;
      sfx('ui');this.draw();
      return;
    }
    if(this.selectedIdx>=0){
      const rotated=rotateAroundCenter(this.ships[this.selectedIdx]);
      if(rotated && canPlaceCells(this.ships,rotated,this.selectedIdx)){
        this.ships[this.selectedIdx]=rotated;
        vib(20);sfx('place');this.draw();
      }else{
        vib(50);toast('⟳ Здесь повернуть нельзя');
      }
    }
  },
  
  remove(){
    if(this.selectedIdx<0)return;
    this.ships.splice(this.selectedIdx,1);
    this.selectedIdx=-1;
    vib(30);sfx('ui');this.draw();this.drawDock();
  },
  
  auto(){const l=randomLayout();if(l){this.ships=l;this.holding=null;this.selectedIdx=-1;sfx('place');vib(30);this.draw();this.drawDock()}},
  clear(){this.ships=[];this.holding=null;this.selectedIdx=-1;this.draw();this.drawDock()},
  
  done(){
    if(this.ships.length<10)return;
    const ships=this.ships.map(s=>s.slice());
    sfx('win');
    if(this.mode==='ai')startAIBattle(ships);
    else if(this.mode==='hs'){
      if(this.phase===0){P._p1=ships;handoff('Передайте телефон','Теперь Игрок 2 расставляет свой флот. Игрок 1 — отвернитесь! 😉',()=>P.start('hs',1))}
      else startHSBattle(P._p1,ships);
    }
    else if(this.mode==='net')netCreateRoom(ships);
  }
};

