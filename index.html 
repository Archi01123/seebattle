/* ═════════ БОЙ ═════════ */
const B={mode:null,ships:[null,null],moves:[],over:null,turnRole:0,cur:0,lock:false,ai:null,boards:[[],[]],log:[]};
const selfRole=()=>B.mode==='hs'?B.cur:(B.mode==='net'?fbMyRole:0);
const landView=b=>(1-b)===selfRole()?0:1;
function hitsOf(role){const s=new Set();B.moves.forEach(m=>{if(m.b===(1-role)&&(m.r==='h'||m.r==='s'))s.add(m.c)});return s}
function marksOn(view){const s=new Set();B.moves.forEach(m=>{if(landView(m.b)===view)s.add(m.c)});return s}
function allSunk(role){const sh=B.ships[role];if(!sh)return false;const h=hitsOf(role);return sh.every(s=>s.every(c=>h.has(c)))}
function roleLabel(r){if(B.mode==='ai')return r===0?'Вы':'🤖 Компьютер';if(B.mode==='hs')return'Игрок '+(r+1);return r===fbMyRole?'Вы':'Соперник'}
function targetName(){return B.mode==='ai'?'🤖 Компьютер':B.mode==='hs'?'🎯 Игрок '+((1-B.cur)+1):'🎯 Флот соперника'}
function myName(){return B.mode==='ai'?'🫵 Ваш флот':B.mode==='hs'?'🛡 Игрок '+(B.cur+1):'🛡 Ваш флот'}

function updateFleets(){
  const my=selfRole(),opp=1-my;
  const mk=role=>{
    const lay=B.ships[role];
    if(lay){const h=hitsOf(role);return lay.map(sh=>({len:sh.length,dead:sh.every(c=>h.has(c))}))}
    const sunk=B.moves.filter(m=>m.r==='s'&&(1-m.b)===role&&m.sc).map(m=>m.sc.length);
    const list=SIZES.map(len=>({len,dead:false}));sunk.forEach(len=>{const f=list.find(x=>x.len===len&&!x.dead);if(f)f.dead=true});
    return list;
  };
  fleetChips($('#fleetTop'),mk(opp));fleetChips($('#fleetBot'),mk(my));
  $('#whoTop').textContent=targetName();$('#whoBot').textContent=myName();
}
function updateTurnbar(){
  const tb=$('#turnbar');tb.classList.remove('me','foe');
  if(B.over){tb.textContent='⚑ Бой окончен';return}
  if(B.mode==='net'){
    if(netTurnIsMine()){tb.textContent='🎯 ВАШ ВЫСТРЕЛ — жмите по клетке!';tb.classList.add('me')}
    else{tb.textContent='⏳ Ход соперника…';tb.classList.add('foe')}
    return;
  }
  const mine=B.mode==='ai'?B.turnRole===0:B.turnRole===B.cur;
  tb.textContent=mine?(B.mode==='hs'?`🎯 Ход игрока ${B.cur+1} — огонь!`:'🎯 Ваш выстрел!'):(B.mode==='ai'?'🤖 Компьютер целится…':`🎯 Ход игрока ${B.cur+1}`);
  tb.classList.add(mine?'me':'foe');
}
function renderAll(){
  B.boards[0].forEach(el=>el.className='c');
  B.boards[1].forEach(el=>el.className='c');
  const mine=selfRole(),lay=B.ships[mine];
  if(lay)lay.forEach(sh=>sh.forEach(c=>B.boards[0][c].classList.add('ship')));
  B.moves.forEach(m=>{
    if(m.r==null){B.boards[1][m.c].classList.add('pend');return}
    const v=landView(m.b);B.boards[v][m.c].classList.add(m.r==='m'?'miss':'hit');
    if(m.r==='s'&&m.sc)m.sc.forEach(c=>B.boards[v][c].classList.add('sunk'));
  });
  updateFleets();updateTurnbar();
}
function addLog(m){
  if(m.a)return;
  B.log.push({who:roleLabel(m.b),cell:fmtCell(m.c),r:m.r});
  const t=$('#ticker');
  const txt=m.r==='m'?'💦 МИМО':m.r==='h'?'💥 ПОПАДАНИЕ!':'☠️ КОРАБЛЬ ПОТОПЛЕН!';
  t.textContent=`${m.who}: ${m.cell} — ${txt}`;
  t.style.color=m.r==='m'?'#cdeefb':m.r==='h'?'#ffd97a':'#ff9a8a';
}
function paintShot(view,m,around,fx){
  const cells=B.boards[view];const el=cells[m.c];
  if(m.r==='m'){el.classList.add('miss');if(fx){sfx('splash');fxSplash(el)}}
  else{el.classList.add('hit');if(fx){sfx(m.r==='s'?'sink':'boom');fxBoom(el);vib(m.r==='s'?[90,50,90,50,220]:[70,40,110])}}
  if(m.r==='s'){
    m.sc.forEach(c=>cells[c].classList.add('sunk'));
    (around||[]).forEach(a=>cells[a].classList.add('miss'));
    if(fx){$('#stageE').classList.add('shake');setTimeout(()=>$('#stageE').classList.remove('shake'),500)}
  }
}
function enterBattle(){
  B.boards=[buildBoard($('#bM')),buildBoard($('#bE'))];B.log=[];
  $('#ticker').textContent='Бой начинается! Все ходы — в журнале (нажмите сюда).';$('#ticker').style.color='';
  $('#roomBar').classList.toggle('hidden',B.mode!=='net');
  if(B.mode==='net'){$('#roomCode').textContent=fbRoomId;$('#roomStatus').textContent='Real-time активен ⚡'}
  renderAll();
}
function localShoot(shooter,cell){
  const target=1-shooter,hits=hitsOf(target);
  const res=checkShot(B.ships[target],hits,cell);
  const m={b:shooter,c:cell,r:res.res==='m'?'m':res.res==='h'?'h':'s',sc:res.sh};
  B.moves.push(m);addLog(m);paintShot(landView(shooter),m,res.around,true);
  if(m.r==='s')toast('🔥 '+fmtLen(m.sc.length)+' корабль потоплен!');
  (res.around||[]).forEach(a=>B.moves.push({b:shooter,c:a,r:'m',a:1}));
  updateFleets();
  if(allSunk(target)){finishBattle(shooter);return}
  if(m.r==='m'){
    if(B.mode==='hs'){B.cur=1-B.cur;B.turnRole=B.cur;
      handoff(`Ход переходит к Игроку ${B.cur+1}`,`Передайте телефон. Игрок ${2-B.cur} — не подглядывайте! 👀`,()=>{renderAll()})}
    else{B.turnRole=1;B.lock=true;updateTurnbar();setTimeout(aiStep,900)}
  }else{
    if(B.mode==='ai'&&shooter===1)setTimeout(aiStep,900);else updateTurnbar();
  }
}
function aiStep(){
  if(B.over)return;
  const taken=marksOn(0);const c=B.ai.choose(taken);
  const hits=hitsOf(0),res=checkShot(B.ships[0],hits,c);
  const m={b:1,c,r:res.res==='m'?'m':res.res==='h'?'h':'s',sc:res.sh};
  B.moves.push(m);addLog(m);paintShot(0,m,res.around,true);
  if(m.r==='s'){B.ai.sunk();toast('🚨 Ваш '+fmtLen(m.sc.length)+' корабль потоплен!')}
  else if(m.r==='h')B.ai.hit(c);
  (res.around||[]).forEach(a=>B.moves.push({b:1,c:a,r:'m',a:1}));
  updateFleets();
  if(allSunk(0)){finishBattle(1);return}
  if(m.r!=='m'){setTimeout(aiStep,950)}else{B.turnRole=0;B.lock=false;updateTurnbar()}
}
function finishBattle(winner){
  B.over=winner;updateTurnbar();
  const my=selfRole();const won=winner===my;
  const entry={t:Date.now(),mode:B.mode,winner,ships:B.mode==='net'?null:[B.ships[0],B.ships[1]],
    moves:B.moves.filter(m=>!m.a).map(m=>({b:m.b,c:m.c,r:m.r})),
    names:B.mode==='hs'?['Игрок 1','Игрок 2']:B.mode==='ai'?['Вы','Компьютер']:['Вы','Соперник']};
  if(B.mode==='net'){entry.netId=fbRoomId;entry.myRole=fbMyRole;entry.ships=null}
  saveHistory(entry);
  if(B.mode==='ai')addResult('ai',won);else if(B.mode==='hs')addResult('hs',null);else addResult('net',won);
  sfx(B.mode==='hs'?'win':won?'win':'lose');vib(won?[60,40,60,40,140]:300);
  setTimeout(()=>showResult(winner),1100);
}
function onEnemyTap(i){
  sfx('ui');
  if(B.over||B.lock)return;
  if(B.mode==='net'){
    if(!netTurnIsMine())return;
    if(B.moves.some(m=>m.b===fbMyRole&&m.c===i)){toast('Сюда уже стреляли');return}
    fbShoot(i);return;
  }
  const shooter=B.mode==='hs'?B.cur:0;
  if(B.turnRole!==shooter)return;
  if(marksOn(1).has(i)){toast('Сюда уже стреляли');return}
  sfx('shoot');localShoot(shooter,i);
}
