/* ═════════ ИГРА ПО FIREBASE (REAL-TIME) ═════════ */
function netTurnIsMine(){
  if(!B.moves.length)return fb.st.first===fbMyRole;
  const last=B.moves[B.moves.length-1];
  if(last.r==null)return false;
  return last.r==='m' ? last.b!==fbMyRole : last.b===fbMyRole;
}
const fb={st:null,first:-1,ships:[null,null]};

function netCreateRoom(ships){
  if(!fb){toast('Сначала настройте Firebase (см. раздел "Игра с другом")');return}
  const id=randCode();
  const shipsHash=btoa(JSON.stringify(ships));
  const ref=fb.db.ref('rooms/'+id);
  const state={
    v:1,
    first:Math.random()<.5?0:1,
    status:'waiting',
    players:{
      0:{ships:shipsHash,ready:true},
      1:{ships:null,ready:false}
    },
    moves:[],
    reveal:{0:null,1:null}
  };
  ref.set(state).then(()=>{
    fbRoomId=id;fbMyRole=0;fbRef=ref;fb.ships[0]=ships;
    $('#waitCode').textContent=id;
    $('#waitTxt').textContent='Скажите сыну этот код — пусть введёт в своей игре';
    $('#waitOvl').classList.remove('hidden');
    fbUnsubscribe=ref.on('value',snap=>{
      const v=snap.val();if(!v)return;
      fb.st=v;
      if(v.status==='playing'){
        $('#waitOvl').classList.add('hidden');
        fb.st=v;enterNetBattle();
      }
    });
  }).catch(e=>toast('Ошибка: '+e.message));
}
$('#waitCancel').onclick=()=>{
  if(fbUnsubscribe)fbUnsubscribe();
  if(fbRef)fbRef.remove().catch(()=>{});
  $('#waitOvl').classList.add('hidden');nav('menu');
};

function netJoinRoom(code){
  if(!fb){toast('Сначала настройте Firebase');return}
  const id=code.trim().toUpperCase();
  if(!/^[A-Z0-9]{6}$/.test(id)){toast('Код должен быть 6 букв/цифр');return}
  const ref=fb.db.ref('rooms/'+id);
  ref.once('value').then(snap=>{
    const v=snap.val();
    if(!v){toast('Комната не найдена');return}
    if(v.status!=='waiting'){toast('Игра уже началась или завершена');return}
    if(v.players[1]&&v.players[1].ready){toast('Второе место уже занято');return}
    fbRoomId=id;fbMyRole=1;fbRef=ref;
    P.mode='net';P.start('net');
  }).catch(e=>toast('Ошибка: '+e.message));
}
$('#btnNetNew').onclick=()=>{if(!fb){toast('Сначала подключите Firebase');return}P.start('net')};
$('#btnNetJoin').onclick=()=>netJoinRoom($('#joinCode').value);

/* когда Игрок 2 расставил — он пишет свои ships и status='playing' */
function netOnPlacedDone(ships){
  const shipsHash=btoa(JSON.stringify(ships));
  fb.ships[fbMyRole]=ships;
  fbRef.update({
    [`players/${fbMyRole}/ships`]:shipsHash,
    [`players/${fbMyRole}/ready`]:true,
    status:'playing'
  });
  fbUnsubscribe=fbRef.on('value',snap=>{
    const v=snap.val();if(!v)return;fb.st=v;updateNetBattle();
  });
  fb.st=fb.st||{first:-1,moves:[],players:{0:{},1:{}},reveal:{0:null,1:null}};
  enterNetBattle();
}
/* перезаписать done для net */
const origDone=P.done;
P.done=function(){
  if(this.ships.length<10)return;
  const ships=this.ships.map(s=>s.slice());
  sfx('win');
  if(this.mode==='ai')startAIBattle(ships);
  else if(this.mode==='hs'){
    if(this.phase===0){P._p1=ships;handoff('Передайте телефон','Теперь Игрок 2 расставляет. Игрок 1 — отвернитесь! 😉',()=>P.start('hs',1))}
    else startHSBattle(P._p1,ships);
  }
  else if(this.mode==='net')netOnPlacedDone(ships);
};

function enterNetBattle(){
  B.mode='net';B.over=null;B.moves=[];
  /* ships пока пустые, будут заполняться из fb.st по мере прихода */
  B.ships=[null,null];
  enterBattle();nav('battle');
}
function updateNetBattle(){
  if(!fb.st)return;
  const v=fb.st;
  /* получаем свои ships если есть */
  if(v.players[fbMyRole]&&v.players[fbMyRole].ships&&fb.ships[fbMyRole])B.ships[fbMyRole]=fb.ships[fbMyRole];
  /* moves из Firebase в B.moves (синхронизация) */
  const fMoves=v.moves||[];
  B.moves=fMoves.map(m=>({b:m[0],c:m[1],r:m[2],sc:m[3],a:m[4]}));
  renderAll();
  /* анимация нового хода если соперник сходил */
  if(fMoves.length>netLastMoveCount){
    const nm=fMoves[fMoves.length-1];
    if(nm[0]!==fbMyRole && nm[2]!=null){
      /* ход соперника по нашему полю */
      const mm={b:nm[0],c:nm[1],r:nm[2],sc:nm[3]};
      paintShot(0,mm,nm[5]||[],true);
      addLog(mm);
      if(nm[2]==='s')toast('🚨 Ваш корабль потоплен!');
      vib(nm[2]==='m'?20:[70,40,110]);
      /* проверка победы соперника */
      if(allSunk(fbMyRole)){finishBattle(1-fbMyRole);netWriteReveal();return}
    }else if(nm[0]===fbMyRole && nm[2]!=null){
      /* результат моего выстрела пришёл */
      const mm={b:nm[0],c:nm[1],r:nm[2],sc:nm[3]};
      addLog(mm);
      if(nm[2]==='s'){toast('🔥 Потоплен!');if(allSunk(1-fbMyRole)){finishBattle(fbMyRole);netWriteReveal();return}}
      else if(nm[2]==='h')toast('💥 Попал! Хожу ещё');
      else toast('💦 Мимо, ход переходит');
    }
  }
  netLastMoveCount=fMoves.length;
}
let netLastMoveCount=0;

function fbShoot(i){
  B.lock=true;
  /* добавляем ход без результата */
  fbRef.child('moves').push([fbMyRole,i,null,null,null]).then(ref=>{
    B.lock=false;
    B.moves.push({b:fbMyRole,c:i,r:null});renderAll();sfx('shoot');
    /* серверный обработчик посчитает результат и допишет в move */
    /* для простоты посчитаем сами и обновим */
    fb.db.ref('rooms/'+fbRoomId).once('value').then(snap=>{
      const v=snap.val();
      const oppShipsHash=v.players[1-fbMyRole].ships;
      if(!oppShipsHash){toast('Соперник ещё не готов');return}
      /* у нас нет настоящих ships соперника — но есть moves с результатами,
         посчитать можем только по уже открытым попаданиям */
      /* поэтому доверим вычисление самому себе на основе уже известных данных */
      computeShotResult(ref.key,i);
    });
  }).catch(e=>{B.lock=false;toast('Ошибка отправки')});
}
function computeShotResult(moveKey,cell){
  fb.db.ref('rooms/'+fbRoomId).once('value').then(snap=>{
    const v=snap.val();
    /* получаем ships соперника из reveal если есть, иначе считаем по открытым попаданиям */
    const myShips=fb.ships[fbMyRole];
    /* собираем все известные попадания соперника по МНЕ */
    const hitsOnMe=new Set();
    for(const m of v.moves){if(m[0]===(1-fbMyRole)&&(m[2]==='h'||m[2]==='s'))hitsOnMe.add(m[1])}
    const res=checkShot(myShips,hitsOnMe,cell);
    /* эй, это не то. Мне нужно проверить попадание ПО СОПЕРНИКУ, а не по себе.
       Проблема: мы не знаем ships соперника, пока игра не кончится.
       Решение: каждый игрок САМ считает результат выстрела СОПЕРНИКА по своему полю.
       Т.е. когда игрок A стреляет, игрок B проверяет: попал ли A по B?
       Значит: результат пишет тот, в кого стреляют. */
    /* Но мы вызываем computeShotResult на стороне стреляющего.
       Правильнее: стреляющий отправляет [role, cell, null], а защищающийся (получатель хода) заполняет result.
       Это сложнее. Сделаем проще: оба игрока хранят свои ships локально, и каждый вычисляет свой собственный "результат выстрела по мне".
       То есть: после отправки хода ждём, когда защищающийся сам вычислит и дополнит move. */
  });
}

/* Переделаем: когда соперник стреляет по мне, я сам считаю результат и дописываю */
function startNetListener(){
  if(fbUnsubscribe)fbUnsubscribe();
  let lastMoves=[];
  fbUnsubscribe=fbRef.on('value',snap=>{
    const v=snap.val();if(!v)return;
    fb.st=v;
    /* проверяем новые ходы соперника */
    const curMoves=v.moves||[];
    for(let i=lastMoves.length;i<curMoves.length;i++){
      const m=curMoves[i];
      if(m[0]!==fbMyRole && m[2]==null){
        /* соперник стрелял по мне, и результат ещё не посчитан — посчитаю я */
        resolveIncomingShot(i,m);
      }
    }
    lastMoves=curMoves;
    if(v.status==='playing')updateNetBattle();
  });
}
function resolveIncomingShot(idx,m){
  const cell=m[1];
  const hitsOnMe=new Set();
  (fb.st.moves||[]).forEach(x=>{
    if(x[0]!==fbMyRole&&(x[2]==='h'||x[2]==='s'))hitsOnMe.add(x[1]);
  });
  const res=checkShot(fb.ships[fbMyRole],hitsOnMe,cell);
  const r=res.res==='m'?'m':res.res==='h'?'h':'s';
  const updates={};
  updates[`moves/${idx}/2`]=r;
  if(r==='s'){updates[`moves/${idx}/3`]=res.sh;updates[`moves/${idx}/5`]=res.around;
    res.around.forEach(a=>fbRef.child('moves').push([fbMyRole,a,'m',null,null,1]))}
  fbRef.update(updates);
  if(r==='s'&&checkAllSunkMine())fbRef.update({status:'over',winner:1-fbMyRole,['reveal/'+fbMyRole]:fb.ships[fbMyRole]});
}
function checkAllSunkMine(){
  const hits=new Set();
  (fb.st.moves||[]).forEach(m=>{if(m[0]!==fbMyRole&&(m[2]==='h'||m[2]==='s'))hits.add(m[1])});
  return fb.ships[fbMyRole].every(s=>s.every(c=>hits.has(c)));
}
function netWriteReveal(){fbRef.update({['reveal/'+fbMyRole]:fb.ships[fbMyRole]})}

/* заменяем enterNetBattle чтобы включать listener */
function enterNetBattleReal(){
  B.mode='net';B.over=null;B.moves=[];B.ships=[null,null];
  B.ships[fbMyRole]=fb.ships[fbMyRole];
  enterBattle();nav('battle');
  startNetListener();
}
/* перезаписываем */
enterNetBattle=enterNetBattleReal;

/* проверяем статус 'over' в listener */
(function(){
  const origUpdate=updateNetBattle;
  updateNetBattle=function(){
    if(fb.st&&fb.st.status==='over'){
      const winner=fb.st.winner;
      if(B.over==null){
        B.over=winner;
        finishBattle(winner);
      }
      return;
    }
    origUpdate();
  };
})();

/* ═════════ история и рейтинг ═════════ */
function saveHistory(e){const h=store.get('bs_hist',[]);h.unshift(e);if(h.length>40)h.length=40;store.set('bs_hist',h)}
function getStats(){return store.get('bs_stats',{games:0,wins:0,losses:0,streak:0,best:0,by:{}})}
function addResult(mode,won){
  const s=getStats();s.games++;s.by[mode]=s.by[mode]||{g:0,w:0,l:0};s.by[mode].g++;
  if(won==null){}else if(won){s.wins++;s.by[mode].w++;s.streak++;s.best=Math.max(s.best,s.streak)}
  else{s.losses++;s.by[mode].l++;s.streak=0}
  store.set('bs_stats',s);
}
const MODE_NAME={ai:'против 🤖',hs:'вдвоём 👥',net:'по коду ⚡'};
function renderHistory(){
  const list=$('#histList');const h=store.get('bs_hist',[]);
  if(!h.length){list.innerHTML='<p class="hint">Пока ни одного боя. ⚓</p>';return}
  list.innerHTML='';h.forEach((e,idx)=>{
    const d=document.createElement('div');d.className='hitem';
    const names=e.names||['Игрок 1','Игрок 2'];
    const wName=names[e.winner]??'—';
    d.innerHTML=`<div><b>${e.mode==='ai'?'🤖':e.mode==='hs'?'👥':'⚡'} ${MODE_NAME[e.mode]}</b>
      <small>${new Date(e.t).toLocaleString('ru-RU',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})} · победил: ${wName} · ходов: ${e.moves.length}</small></div>
      <button class="btn sm">▶</button>`;
    d.querySelector('button').onclick=()=>viewGame(idx);list.appendChild(d);
  });
}
function viewGame(idx){
  const e=store.get('bs_hist',[])[idx];if(!e)return;
  $('#viewTitle').textContent=e.mode==='net'?'Онлайн-бой #'+(e.netId||''):'Бой '+new Date(e.t).toLocaleDateString('ru-RU');
  const names=e.names||['Игрок 1','Игрок 2'];
  $('#viewBotName').textContent='🛡 '+(e.mode==='net'?names[e.myRole??0]:names[0]);
  $('#viewTopName').textContent='🎯 '+(e.mode==='net'?names[1-(e.myRole??0)]:names[1]);
  const top=buildBoard($('#vTop')),bot=buildBoard($('#vBot'));
  const lay=e.ships;
  if(lay){lay[0].forEach(s=>s.forEach(c=>bot[c].classList.add('ship')));lay[1].forEach(s=>s.forEach(c=>top[c].classList.add('ship')))}
  const hits=[new Set(),new Set()];
  e.moves.forEach(m=>{const view=1-m.b;const cells=view?top:bot;
    cells[m.c].classList.add(m.r==='m'?'miss':'hit');if(m.r!=='m')hits[m.b].add(m.c)});
  if(lay)lay.forEach((l,r)=>l.forEach(s=>{if(s.every(c=>hits[r].has(c)))s.forEach(c=>(r?top:bot)[c].classList.add('sunk'))}));
  const mkFleet=(el,r)=>{if(lay)fleetChips(el,lay[r].map(s=>({len:s.length,dead:s.every(c=>hits[r].has(c))})));else el.innerHTML='<span class="badge">флот скрыт 🔒</span>'};
  mkFleet($('#viewFleetTop'),1);mkFleet($('#viewFleetBot'),0);
  const ol=$('#viewMoves');ol.innerHTML='';
  e.moves.forEach((m,i)=>{
    const li=document.createElement('li');
    li.innerHTML=`<span class="dot ${m.r==='m'?'m':m.r==='h'?'h':'s'}"></span>${i+1}. ${names[m.b]}: <b>&nbsp;${fmtCell(m.c)}</b>&nbsp;— ${m.r==='m'?'мимо':m.r==='h'?'попадание':'потопил!'}`;ol.appendChild(li);
  });
  $('#viewCount').textContent=e.moves.length+' выстрелов';nav('view');
}
function renderStats(){
  const s=getStats();const g=$('#statGrid');
  const pct=s.games?Math.round(s.wins/s.games*100):0;
  g.innerHTML=`<div class="stat"><b>${s.games}</b><span>всего боёв</span></div>
    <div class="stat"><b>${s.wins}</b><span>побед</span></div>
    <div class="stat"><b>${pct}%</b><span>процент побед</span></div>
    <div class="stat"><b>${s.best}</b><span>лучшая серия</span></div>`;
  const rows=$('#statRows');rows.innerHTML='';
  ['ai','net','hs'].forEach(k=>{
    const b=s.by[k]||{g:0,w:0,l:0};const d=document.createElement('div');d.className='tgl';
    d.innerHTML=`<span>${MODE_NAME[k]}</span><span class="badge">${b.g} игр · ${b.w} побед${b.l?' · '+b.l+' пораж.':''}</span>`;rows.appendChild(d);
  });
}
function refreshMenuStats(){
  const s=getStats();
  $('#menuStats').textContent=s.games?`⚓ Сыграно: ${s.games} · Побед: ${s.wins} · Серия: ${s.streak}`:'⚓ Ваш флот ждёт приказа, адмирал!';
}
