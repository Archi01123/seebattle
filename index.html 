<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#062c47">
<title>⚓ Морской бой</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Russo+One&family=Nunito:wght@400;700;800;900&display=swap" rel="stylesheet">
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<style>
:root{
  --ink:#04223a;--deep:#062c47;--sea:#0b3f63;--sea2:#0f537f;
  --aqua:#35c4dc;--aqua2:#8fe6f4;--foam:#eefaff;
  --coral:#ff6b4a;--amber:#ffc24b;--green:#39d98a;--red:#ff5d5d;
  --card:rgba(9,44,72,.92);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{touch-action:manipulation}
body{font-family:Nunito,system-ui,sans-serif;color:var(--foam);min-height:100vh;overflow-x:hidden;
  background:linear-gradient(180deg,#a5e3f5 0%,#5cb6e0 22%,#2b8ec4 40%,#0e5d8c 60%,#083a5e 100%);
  background-attachment:fixed}
h1,h2,h3,.logo,.btn,.mbtn b{font-family:'Russo One',Nunito,sans-serif;font-weight:400;letter-spacing:.4px}
button{font:inherit;color:inherit;border:0;cursor:pointer;user-select:none}
.hidden{display:none!important}
.center{text-align:center}

#scene{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.sun{position:absolute;top:4vh;right:8vw;width:70px;height:70px;border-radius:50%;
  background:radial-gradient(circle,#fff8d8,#ffd76a 60%,rgba(255,215,106,0) 72%);filter:blur(1px)}
.cloud{position:absolute;width:130px;height:34px;border-radius:40px;background:rgba(255,255,255,.85);filter:blur(2px);animation:drift linear infinite}
.cloud::before,.cloud::after{content:'';position:absolute;background:inherit;border-radius:50%}
.cloud::before{width:56px;height:56px;left:18px;top:-26px}
.cloud::after{width:40px;height:40px;right:22px;top:-16px}
.c1{top:8vh;animation-duration:70s}
.c2{top:16vh;transform:scale(.7);animation-duration:95s;animation-delay:-40s;opacity:.8}
.c3{top:3vh;transform:scale(1.25);animation-duration:120s;animation-delay:-70s;opacity:.65}
@keyframes drift{from{left:-25%}to{left:110%}}
.boat{position:absolute;bottom:16vh;left:12vw;font-size:44px;animation:bob 4.2s ease-in-out infinite;filter:drop-shadow(0 6px 4px rgba(0,20,40,.35))}
@keyframes bob{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-10px) rotate(3deg)}}
.wave{position:absolute;left:0;bottom:0;width:200%;display:block}
.w1{height:14vh;fill:#0d4c78;animation:sway 11s ease-in-out infinite alternate}
.w2{height:10vh;fill:#093a5e;animation:sway 8s ease-in-out infinite alternate-reverse}
.w3{height:6vh;fill:#062c47;animation:sway 6s ease-in-out infinite alternate}
@keyframes sway{from{transform:translateX(0)}to{transform:translateX(-25%)}}

#app{position:relative;z-index:1;max-width:540px;margin:0 auto;padding:14px 12px 40px}
.scr{display:none;animation:up .35s ease}
.scr.on{display:block}
@keyframes up{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

.masthead{display:flex;align-items:center;gap:14px;padding:18px 6px 8px}
.flag{width:64px;height:64px;border-radius:16px;background:linear-gradient(160deg,#124a77,#0a3152);
  display:grid;place-items:center;font-size:34px;box-shadow:0 6px 0 #052338,0 10px 22px rgba(0,20,40,.45);animation:bob 5s ease-in-out infinite}
.logo{font-size:clamp(34px,10vw,52px);line-height:.95;color:#fff;text-shadow:0 3px 0 #0a3a5e,0 7px 16px rgba(0,20,40,.5)}
.logo span{color:var(--amber)}
.tag{margin:6px 6px 0;font-size:13px;font-weight:800;color:#dff4ff;opacity:.9}
.menu{display:flex;flex-direction:column;gap:10px;margin-top:18px}
.mbtn{display:flex;align-items:center;gap:12px;text-align:left;width:100%;padding:14px 16px;border-radius:14px;
  background:var(--card);box-shadow:0 5px 0 rgba(3,22,38,.9),0 8px 18px rgba(0,20,40,.35);
  font-size:16px;font-weight:800;color:var(--foam);transition:transform .12s,box-shadow .12s}
.mbtn:active{transform:translateY(3px);box-shadow:0 2px 0 rgba(3,22,38,.9)}
.mbtn b{flex:0 0 44px;height:44px;display:grid;place-items:center;border-radius:12px;font-size:22px;font-weight:400}
.c1 b{background:#35c4dc33;box-shadow:inset 0 0 0 2px #35c4dc}
.c2 b{background:#39d98a33;box-shadow:inset 0 0 0 2px #39d98a}
.c3 b{background:#ffc24b33;box-shadow:inset 0 0 0 2px #ffc24b}
.c4 b{background:#ff6b4a33;box-shadow:inset 0 0 0 2px #ff6b4a}
.c5 b{background:#7fb2ff33;box-shadow:inset 0 0 0 2px #7fb2ff}
.c6 b{background:#c9d6dd33;box-shadow:inset 0 0 0 2px #c9d6dd}
small.under{display:block;font-size:11px;font-weight:700;opacity:.65}

h2{font-size:24px;margin:10px 4px 4px;text-shadow:0 2px 0 rgba(4,30,50,.6)}
.hint{font-size:13px;font-weight:700;color:#bfe6f5;margin:4px 4px 10px;line-height:1.45}
.warn{font-size:12.5px;font-weight:700;color:#ffd9a1;background:#5c3a1088;border:1px dashed #ffc24b;border-radius:10px;padding:9px 11px;margin-top:12px}
.panel{background:var(--card);border-radius:16px;padding:14px;margin:12px 0;box-shadow:0 6px 0 rgba(3,22,38,.85),0 10px 24px rgba(0,20,40,.35)}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.row.between{justify-content:space-between;align-items:center;margin-top:0}
.btn,.big{display:inline-flex;align-items:center;justify-content:center;gap:7px;border-radius:12px;
  padding:12px 16px;font-size:15px;background:linear-gradient(180deg,#39c4dc,#1d94b4);color:#03202f;
  box-shadow:0 4px 0 #0c5874;transition:transform .1s}
.btn:active,.big:active{transform:translateY(3px);box-shadow:0 1px 0 #0c5874}
.big.amber{background:linear-gradient(180deg,#ffd069,#f5a623);box-shadow:0 4px 0 #9c6206;color:#3a2400}
.big.amber:active{box-shadow:0 1px 0 #9c6206}
.big.green{background:linear-gradient(180deg,#5ff0a5,#22b86b);box-shadow:0 4px 0 #0d6b3c;color:#04331b}
.big.green:active{box-shadow:0 1px 0 #0d6b3c}
.big.ghost{background:transparent;box-shadow:inset 0 0 0 2px #7fb9d6;color:#dff4ff}
.big.danger{background:linear-gradient(180deg,#ff8a70,#e2492c);box-shadow:0 4px 0 #7d2110;color:#fff}
.btn.sm{padding:9px 12px;font-size:13.5px}
.btn.back{position:absolute;top:6px;left:6px;z-index:5;background:#0a315299;color:#dff4ff;box-shadow:inset 0 0 0 1.5px #4b90b5;padding:8px 12px;border-radius:10px}
.chk{display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:800;margin:10px 4px;color:#dff4ff}
.chk input{width:19px;height:19px;accent-color:var(--amber)}
textarea,input[type=text]{width:100%;border-radius:10px;border:2px solid #2f7ba6;background:#06263e;color:var(--foam);padding:9px;font:inherit;font-size:14px;resize:none}
input[type=text]:focus,textarea:focus{outline:0;border-color:var(--amber)}

.bstage{position:relative;width:min(96vw,450px);margin:8px auto}
.bstage.small{width:min(84vw,370px)}
.board{display:grid;grid-template-columns:1.15em repeat(10,1fr);gap:2.5px;padding:6px;border-radius:12px;
  background:linear-gradient(160deg,#0a3757,#062942);box-shadow:inset 0 0 0 2px #1d5e86,0 6px 14px rgba(0,20,40,.4)}
.lbl{display:grid;place-items:center;font-size:.62em;font-weight:900;color:#7fd0e8}
.board{font-size:clamp(11px,3.2vw,15px)}
.bstage.small .board{font-size:clamp(10px,2.7vw,13px)}
.corner{opacity:0}
.c{position:relative;aspect-ratio:1;border-radius:3.5px;background:linear-gradient(160deg,rgba(125,215,238,.30),rgba(30,110,150,.32));
  box-shadow:inset 0 0 0 1px rgba(190,240,255,.15);transition:background .12s}
.tapzone .c:not(.miss):not(.hit):active{background:rgba(255,255,255,.4)}
.c.ship{background:linear-gradient(160deg,#d4dee4,#93a9b5);box-shadow:inset 0 0 0 2px #46617370,inset 0 -3px 0 #5d7686}
.c.ship.sel{box-shadow:inset 0 0 0 2px var(--amber),0 0 0 3px var(--amber),inset 0 -3px 0 #5d7686;animation:pulse 1.2s infinite}
.c.halo{background:rgba(255,206,84,.24);box-shadow:inset 0 0 0 1px rgba(255,206,84,.45)}
.c.prevok{background:rgba(57,217,138,.7)!important;box-shadow:inset 0 0 0 2px #39d98a!important}
.c.prevbad{background:rgba(255,93,93,.75)!important;box-shadow:inset 0 0 0 2px #ff5d5d!important}
.c.hit{background:radial-gradient(circle at 50% 38%,#ffb36b,#d3402a 72%)}
.c.hit::before,.c.hit::after{content:'';position:absolute;left:16%;right:16%;top:44%;height:13%;border-radius:2px;background:#57150a}
.c.hit::before{transform:rotate(45deg)}.c.hit::after{transform:rotate(-45deg)}
.c.miss::after{content:'';position:absolute;inset:0;margin:auto;width:28%;height:28%;border-radius:50%;
  background:radial-gradient(circle,#fff,rgba(255,255,255,.12) 75%)}
.c.sunk{background:#802314!important;box-shadow:inset 0 0 0 2px #3f0e06}
.c.pend{box-shadow:inset 0 0 0 2px var(--amber)}
.c.pend::after{content:'✦';position:absolute;inset:0;display:grid;place-items:center;color:var(--amber);animation:pulse 1s infinite}
@keyframes pulse{50%{opacity:.25;transform:scale(.8)}}
.c.badflash{background:#ff5d5d!important}
.shake{animation:shk .45s}
@keyframes shk{0%,100%{transform:none}20%{transform:translate(-5px,2px)}40%{transform:translate(5px,-2px)}60%{transform:translate(-4px,-2px)}80%{transform:translate(3px,2px)}}
.sweep{position:absolute;inset:6px;border-radius:10px;pointer-events:none;opacity:.5;
  background:conic-gradient(from 0deg,transparent 0 78%,rgba(94,255,196,.16) 92%,transparent 100%);animation:spin 5s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.boomfx{position:absolute;inset:-45%;border-radius:50%;pointer-events:none;
  background:radial-gradient(circle,#fff7d1 0%,#ffc24b 32%,#ff6b4a 58%,transparent 72%);animation:boom .55s ease-out forwards}
@keyframes boom{from{transform:scale(.15);opacity:1}to{transform:scale(1.7);opacity:0}}
.ringfx{position:absolute;inset:-35%;border:3px solid rgba(225,250,255,.95);border-radius:50%;pointer-events:none;animation:ring .7s ease-out forwards}
@keyframes ring{from{transform:scale(.2);opacity:1}to{transform:scale(1.5);opacity:0}}
.dropfx{position:absolute;left:50%;top:50%;width:5px;height:5px;border-radius:50%;background:#e2f7ff;pointer-events:none;animation:drop .6s ease-out forwards}
@keyframes drop{to{transform:translate(var(--dx),var(--dy)) scale(.2);opacity:0}}

.bwrap{position:relative;padding-top:8px}
.bhead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:6px 2px}
.chip{font-weight:900;font-size:14px;background:#0a315299;padding:6px 11px;border-radius:10px;box-shadow:inset 0 0 0 1.5px #4b90b5}
.fleet{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.fchip{display:flex;gap:1.5px;padding:2px;border-radius:4px;background:#06263e99}
.fchip i{width:7px;height:7px;border-radius:2px;background:#9fd8e8}
.fchip.dead{opacity:.3;filter:grayscale(1)}
#turnbar{text-align:center;margin:8px 0 4px;font-family:'Russo One';font-size:17px;text-shadow:0 2px 0 rgba(4,30,50,.6)}
#turnbar.me{color:#ffd97a;animation:pulse 1.4s infinite}
#turnbar.foe{color:#9fc9dd}
.ticker{margin:2px auto 8px;max-width:min(96vw,450px);background:#06263ecc;border-radius:10px;padding:8px 12px;
  font-size:13px;font-weight:800;color:#cdeefb;text-align:center;box-shadow:inset 0 0 0 1px #2f7ba655;cursor:pointer}
.roombar{background:#0f537fcc;border:1.5px solid var(--green);border-radius:14px;padding:12px;margin:10px 0;text-align:center}
.roombar p{font-size:14px;font-weight:800;color:#c4ffe0;margin-bottom:8px}
.roomcode{display:inline-block;font-family:'Russo One';font-size:28px;letter-spacing:3px;background:#06263e;padding:8px 18px;border-radius:10px;color:var(--amber);box-shadow:inset 0 0 0 2px var(--amber);margin:6px 0;user-select:all}

.dock{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin:14px auto;padding:12px;background:#0a3152aa;border-radius:14px;box-shadow:inset 0 0 0 1.5px #2f7ba655}
.dchip{display:flex;gap:2px;padding:8px 10px;border-radius:9px;background:#06263e;box-shadow:inset 0 0 0 2px #2f7ba6;opacity:.55;transition:.15s;cursor:pointer}
.dchip.avail{opacity:1}
.dchip.sel{box-shadow:inset 0 0 0 2px var(--amber),0 0 0 3px var(--amber);background:#4a3407;transform:scale(1.08)}
.dchip.empty{opacity:.18;pointer-events:none}
.dchip i{width:14px;height:14px;border-radius:3px;background:linear-gradient(160deg,#d4dee4,#93a9b5);box-shadow:inset 0 -2px 0 #5d7686}
.dchip.sel i{background:linear-gradient(160deg,#ffe084,#f5a623);box-shadow:inset 0 -2px 0 #9c6206}
.dchip .count{font-weight:900;font-size:11px;color:#ffd97a;margin-left:6px;align-self:center}

.place-controls{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin:10px 0}
.place-controls .btn{font-size:13px}
.place-hint{text-align:center;font-size:13px;font-weight:800;color:#ffd97a;margin:6px 4px;min-height:18px}

.olist{list-style:none;max-height:52vh;overflow:auto;padding-left:4px}
.olist li{padding:7px 8px;border-bottom:1px solid #1d5e8666;font-size:13.5px;font-weight:700;display:flex;gap:8px;align-items:center}
.dot{flex:0 0 10px;height:10px;border-radius:50%}
.dot.h{background:var(--coral)}.dot.m{background:#8fd0e8}.dot.s{background:var(--red)}
.hitem{display:flex;justify-content:space-between;align-items:center;gap:8px;background:#0a315299;border-radius:12px;padding:11px 13px;margin-bottom:9px;box-shadow:inset 0 0 0 1px #2f7ba655}
.hitem b{font-size:14.5px}
.hitem small{display:block;font-size:11.5px;opacity:.7;font-weight:700}
.badge{font-size:11px;font-weight:900;padding:3px 8px;border-radius:8px;background:#124a77}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.stat{background:#0a3152aa;border-radius:12px;padding:11px;text-align:center;box-shadow:inset 0 0 0 1px #2f7ba655}
.stat b{display:block;font-size:26px;font-family:'Russo One';color:var(--amber)}
.stat span{font-size:12px;font-weight:800;opacity:.85}
.tgl{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 4px;border-bottom:1px solid #1d5e8655;font-weight:800;font-size:14.5px}
.tgl input{display:none}
.tgl i{flex:0 0 52px;height:29px;border-radius:20px;background:#123a58;position:relative;transition:.2s;box-shadow:inset 0 0 0 2px #2f7ba6}
.tgl i::after{content:'';position:absolute;top:3px;left:3px;width:23px;height:23px;border-radius:50%;background:#8fb8cd;transition:.2s}
.tgl input:checked+i{background:#1c7a4a;box-shadow:inset 0 0 0 2px #39d98a}
.tgl input:checked+i::after{left:26px;background:#eafff3}

.ovl{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:20px;
  background:radial-gradient(circle at 50% 30%,#0d466ef0,#041c30f7)}
.ovl .panel{width:100%;max-width:400px;text-align:center}
.big-emoji{font-size:52px;margin-bottom:6px;animation:bob 3s ease-in-out infinite}
#toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(80px);z-index:80;
  background:#04203af0;border:1.5px solid var(--amber);color:#ffe6b0;font-weight:800;font-size:13.5px;
  padding:11px 16px;border-radius:12px;max-width:88vw;transition:.3s;opacity:0;text-align:center}
#toast.on{transform:translateX(-50%) translateY(0);opacity:1}
#resEmoji{font-size:64px;animation:bob 2.6s ease-in-out infinite}
#resTitle{font-size:clamp(30px,9vw,44px);margin:4px 0}
#resTitle.win{color:#ffd97a;text-shadow:0 3px 0 #7a4b00}
#resTitle.lose{color:#9fc9dd}
.conf{position:absolute;top:-10px;width:9px;height:13px;border-radius:2px;animation:fall linear forwards;z-index:2}
@keyframes fall{to{transform:translateY(105vh) rotate(720deg);opacity:.4}}

.code-input{font-family:'Russo One';font-size:24px;text-align:center;letter-spacing:4px;text-transform:uppercase}
#fbStatus{font-size:12px;font-weight:800;padding:6px 10px;border-radius:8px;margin-top:8px}
#fbStatus.ok{background:#163a2a;color:#7fffa8;box-shadow:inset 0 0 0 1px #39d98a}
#fbStatus.err{background:#5a2020;color:#ff9090;box-shadow:inset 0 0 0 1px #ff5d5d}
#fbStatus.wait{background:#3a2a08;color:#ffc24b;box-shadow:inset 0 0 0 1px #ffc24b}

.helpbox{background:#0a3152aa;border-radius:12px;padding:12px;margin:10px 0;box-shadow:inset 0 0 0 1px #2f7ba655}
.helpbox ol{padding-left:22px;font-size:12.5px;line-height:1.6}
.helpbox code{background:#06263e;padding:2px 6px;border-radius:4px;font-size:11.5px;color:#7fffa8}
.helpbox a{color:var(--amber)}
</style>
</head>
<body>

<div id="scene">
  <div class="sun"></div>
  <div class="cloud c1"></div><div class="cloud c2"></div><div class="cloud c3"></div>
  <div class="boat">⛵</div>
  <svg class="wave w1" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0,60 C150,110 350,10 600,60 C850,110 1050,10 1200,60 L1200,120 L0,120 Z"/></svg>
  <svg class="wave w2" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0,60 C200,10 400,110 600,60 C800,10 1000,110 1200,60 L1200,120 L0,120 Z"/></svg>
  <svg class="wave w3" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0,70 C150,110 400,30 600,70 C800,110 1050,30 1200,70 L1200,120 L0,120 Z"/></svg>
</div>

<main id="app">

<!-- МЕНЮ -->
<section id="scr-menu" class="scr on">
  <div class="masthead">
    <div class="flag">⚓</div>
    <div><h1 class="logo">МОРСКОЙ<br><span>БОЙ</span></h1></div>
  </div>
  <p class="tag">Real-time по коду комнаты · попал — ходи ещё · с сыном за 30 секунд</p>
  <nav class="menu">
    <button class="mbtn c1" data-go="ai"><b>🤖</b><span>Против компьютера<small class="under">одиночная игра</small></span></button>
    <button class="mbtn c2" data-go="hs"><b>👥</b><span>Вдвоём на одном телефоне<small class="under">передавайте телефон по очереди</small></span></button>
    <button class="mbtn c3" data-go="net"><b>⚡</b><span>С другом — real-time по коду<small class="under">мгновенно, без QR и ссылок</small></span></button>
    <button class="mbtn c4" data-go="history"><b>🗂</b><span>История боёв<small class="under">расположение флота и все ходы</small></span></button>
    <button class="mbtn c5" data-go="stats"><b>🏅</b><span>Рейтинг<small class="under">победы, серии, статистика</small></span></button>
    <button class="mbtn c6" data-go="settings"><b>⚙️</b><span>Настройки<small class="under">вибрация, эффекты, выделение клеток</small></span></button>
  </nav>
  <p id="menuStats" class="hint center" style="margin-top:16px"></p>
</section>

<!-- РАССТАНОВКА -->
<section id="scr-place" class="scr">
  <button class="btn back sm" id="btnBackPlace">‹</button>
  <h2 id="placeTitle">Расставьте корабли</h2>
  <p id="placeSub" class="hint">👆 Тапни корабль в доке → водишь пальцем по полю (видишь зелёный/красный превью) → отпусти чтобы поставить. Тап по поставленному — повернуть на месте.</p>
  <div class="bstage"><div id="bP" class="board"></div></div>
  <p id="placeHint" class="place-hint">Выберите корабль в доке ↓</p>
  <div id="dock" class="dock"></div>
  <div class="place-controls">
    <button id="btnRotate" class="btn sm">⟳ Повернуть</button>
    <button id="btnRemove" class="btn sm danger" disabled>✕ Убрать</button>
    <button id="btnAuto" class="btn sm amber">🎲 Авто</button>
    <button id="btnClear" class="btn sm">🗑 Сброс</button>
  </div>
  <label class="chk"><input type="checkbox" id="chkHalo"> Подсветка 1 клетки вокруг кораблей</label>
  <div class="center"><button id="btnPlaceDone" class="big green" disabled>В бой! ⚓</button></div>
</section>

<!-- БОЙ -->
<section id="scr-battle" class="scr">
  <div class="bwrap">
